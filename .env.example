# ── Business identity (one Korafi instance per customer) ──────────────
BUSINESS_NAME=Kano Water Board
USSD_CODE=*384*1234#
SMS_SENDER_ID=
DEFAULT_LANGUAGE=ha            # ha | en
DEFAULT_REWARD=50              # airtime amount per confirmed resolution
REWARD_CURRENCY=NGN
MAX_REWARDS_PER_PHONE_PER_DAY=3
SUPPORTED_AREAS=Kabuga,Hotoro,Tarauni,Sabon Gari
# Optional: Name:lat:lng;Name:lat:lng  (used by the dashboard map)
AREA_COORDS=
SUPPORTED_CATEGORIES=power,water,network,delivery,other

# ── Incident engine ───────────────────────────────────────────────────
INCIDENT_THRESHOLD=3           # distinct customers needed to flag a possible incident
INCIDENT_WINDOW_MINUTES=20

# ── Africa's Talking ──────────────────────────────────────────────────
# Use AT_USERNAME=sandbox with a sandbox API key while testing.
# Leave AT_API_KEY empty to run in dry-run mode (messages are logged, not sent).
AT_USERNAME=sandbox
AT_API_KEY=
AT_VOICE_NUMBER=
PUBLIC_URL=http://localhost:3000

# ── Platform ──────────────────────────────────────────────────────────
PORT=3000
DATABASE_URL=                  # postgres://user:pass@host:5432/korafi  (empty = embedded Postgres in ./data)
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-too
# Shared secret appended to webhook URLs as ?key=... (recommended in production)
WEBHOOK_KEY=
